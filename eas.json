{
  "cli": {
    "version": ">= 18.13.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_API_WEB": "https://staging-api.rondev.com.ph",
        "EXPO_PUBLIC_API_MOBILE": "https://staging-api.rondev.com.ph",
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",  
         "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_WEB": "https://api.rondev.com.ph",
        "EXPO_PUBLIC_API_MOBILE": "https://api.rondev.com.ph"
      }
    }
  },
  "submit": {
    "production": {}
  }
}