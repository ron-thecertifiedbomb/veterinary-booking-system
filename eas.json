{
  "cli": {
    "version": ">= 18.13.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_API_WEB": "http://localhost:3000",
        "EXPO_PUBLIC_API_MOBILE": "http://192.168.100.43:3000",
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "test",
        "EXPO_PUBLIC_API_WEB": "https://api.staging.rondev.com.ph",
        "EXPO_PUBLIC_API_MOBILE": "https://api.staging.rondev.com.ph",
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_WEB": "https://api.staging.rondev.com.ph",
        "EXPO_PUBLIC_API_MOBILE": "https://api.staging.rondev.com.ph",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
