# Vet booking app (Expo web) — production
# Copy on VPS: cp veterinary-booking-system/.env.production.example veterinary-booking-system/.env.production

EXPO_PUBLIC_APP_ENV=production
# Use staging API until api.rondev.com.ph has TLS (then switch back to https://api.rondev.com.ph)
EXPO_PUBLIC_API_WEB=https://staging-api.rondev.com.ph
EXPO_PUBLIC_API_MOBILE=https://staging-api.rondev.com.ph
VET_WEB_PORT=8093
VET_WEB_CONTAINER=rondev-vet-web-prod
